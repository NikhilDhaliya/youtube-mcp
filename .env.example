# 32 random bytes, base64: openssl rand -base64 32
# Seals tokens, sessions and the channel list. Changing it signs every client out and needs channels re-added.
CONNECTOR_KEY=

# Google Cloud: a Google Auth Platform client of type "Web application",
# redirect URI https://<your-domain>/auth/google/callback (and http://localhost:3000/auth/google/callback for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud: an API key restricted to the YouTube Data API v3
YOUTUBE_API_KEY=

# Google accounts that may sign in, connect Claude and manage channels (comma-separated)
OWNER_EMAILS=you@gmail.com

# Made by /setup after you add a channel. Leave empty at first.
YOUTUBE_CHANNELS=

# Optional: your public URL if it isn't Vercel's production domain
# APP_URL=https://yt.example.com
